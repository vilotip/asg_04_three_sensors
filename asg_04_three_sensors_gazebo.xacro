<?xml version="1.0"?>
<robot>  
 
  <gazebo>
    <plugin name="differential_drive_controller" filename="libgazebo_ros_diff_drive.so">
      <alwaysOn>false</alwaysOn>
      <legacyMode>false</legacyMode>
      <updateRate>20</updateRate>
      <leftJoint>left_wheel_joint</leftJoint>
      <rightJoint>right_wheel_joint</rightJoint>
      <wheelSeparation>${wheel_separation}</wheelSeparation>
      <wheelDiameter>${wheel_radius * 2}</wheelDiameter>
      <torque>20</torque>
      <commandTopic>/cmd_vel</commandTopic>
      <odometryTopic>/odom</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <robotBaseFrame>base_footprint</robotBaseFrame>
    </plugin>
  </gazebo>
  
  <gazebo reference="laser_1_link">
    <sensor type="ray" name="laser_sensor_1">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>40</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>5</samples>
            <min_angle>-0.0349066</min_angle>
            <max_angle>0.0349066</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.10</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_head_hokuyo_controller_1" filename="libgazebo_ros_laser.so">
        <topicName>/scan_1</topicName>
        <frameName>laser_1_link</frameName>
      </plugin>
    </sensor>
  </gazebo>

  
  <gazebo reference="laser_2_link">
    <sensor type="ray" name="laser_sensor_2">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>40</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>5</samples>
            <min_angle>-0.0349066</min_angle>
            <max_angle>0.0349066</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.10</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_head_hokuyo_controller_2" filename="libgazebo_ros_laser.so">
        <topicName>/scan_2</topicName>
        <frameName>laser_2_link</frameName>
      </plugin>
    </sensor>
  </gazebo>

  
  <gazebo reference="laser_3_link">
    <sensor type="ray" name="laser_sensor_3">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>40</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>5</samples>
            <min_angle>-0.0349066</min_angle>
            <max_angle>0.0349066</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.10</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_head_hokuyo_controller_3" filename="libgazebo_ros_laser.so">
        <topicName>/scan_3</topicName>
        <frameName>laser_3_link</frameName>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="base_link"> 
    <material>Gazebo/White</material> 
  </gazebo> 
  <gazebo reference="left_wheel"> 
    <material>Gazebo/Red</material> 
  </gazebo> 
  <gazebo reference="right_wheel"> 
    <material>Gazebo/Red</material> 
  </gazebo> 
  
</robot>

